# DonaDoc Frontend: variables de entorno. Copie este archivo a ".env" y complete los valores. Todas están en blanco a propósito.
# ".env" está en .gitignore: NUNCA lo publique. Estas variables se leen al compilar (VITE_*) o al arrancar el contenedor.
VITE_TENANT_KEY=
VITE_ASSET_BASE=
CDN_ORIGIN=
# URL base de la API (backend). En Vercel: https://<su-backend>.vercel.app/api/v1 ; vacío = mismo origen (/api/v1)
VITE_API_BASE_URL=
